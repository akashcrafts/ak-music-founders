# Server Configuration
PORT=3001
NODE_ENV=development

# Upload Limits & Paths
MAX_FILE_SIZE_MB=150
TEMP_DIR=uploads/temp
MEDIA_DIR=uploads/media
TEMP_FILE_TTL_MINUTES=60

# Audio Separation Provider
# Options: "auto", "dsp" (built-in FFmpeg dynamic phase/formant isolation), "demucs", "spleeter"
SEPARATION_PROVIDER=auto
DEMUCS_PATH=
SPLEETER_PATH=

# Music Recognition Providers (Optional external commercial APIs)
# Leave blank to use built-in acoustic signature & fingerprint database engine
AUDD_API_KEY=
ACRCLOUD_HOST=
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_SECRET_KEY=

# Legitimate Source Discovery
# Jamendo API (optional client ID for CC music downloads; fallback public endpoints enabled by default)
JAMENDO_CLIENT_ID=
